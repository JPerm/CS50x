{% comment %}
  ============================================================
  SHOPIFY EMAIL — 2×2 IMAGE GRID
  ============================================================
  1. Set your four image URLs in the IMAGES section below.
  2. Adjust SIZE & STYLE settings to taste.
  3. Paste the whole file into a Custom HTML block in the
     Shopify Email editor.
  ============================================================
{% endcomment %}

{% comment %} ── SIZE & STYLE ─────────────────────────────── {% endcomment %}
{% assign grid_width    = 600 %}   {% comment %} px — total width of the grid {% endcomment %}
{% assign gap           = 6   %}   {% comment %} px — space between images {% endcomment %}
{% assign outer_radius  = 0   %}   {% comment %} px — rounded corners on outer grid {% endcomment %}
{% assign cell_radius   = 0   %}   {% comment %} px — rounded corners on each image {% endcomment %}
{% assign grid_opacity  = 1   %}   {% comment %} 0.0 – 1.0 — opacity of whole block {% endcomment %}
{% assign img_opacity   = 1   %}   {% comment %} 0.0 – 1.0 — opacity on each image {% endcomment %}
{% assign gap_color     = '#ffffff' %}  {% comment %} colour shown in the gaps {% endcomment %}

{% comment %} ── IMAGES ───────────────────────────────────── {% endcomment %}
{% comment %}
  Replace each URL below with your own image URL.
  To get a URL from Shopify: go to Content > Files, upload your
  image, then right-click → Copy image address.
{% endcomment %}

{% assign img1 = 'https://PASTE-YOUR-IMAGE-URL-HERE-1.jpg' %}
{% assign img2 = 'https://PASTE-YOUR-IMAGE-URL-HERE-2.jpg' %}
{% assign img3 = 'https://PASTE-YOUR-IMAGE-URL-HERE-3.jpg' %}
{% assign img4 = 'https://PASTE-YOUR-IMAGE-URL-HERE-4.jpg' %}

{% comment %} Alt text (shown when images are blocked) {% endcomment %}
{% assign alt1 = 'Product image 1' %}
{% assign alt2 = 'Product image 2' %}
{% assign alt3 = 'Product image 3' %}
{% assign alt4 = 'Product image 4' %}

{% comment %} Click-through links — set to '#' to disable {% endcomment %}
{% assign link1 = '#' %}
{% assign link2 = '#' %}
{% assign link3 = '#' %}
{% assign link4 = '#' %}

{% comment %} ── COMPUTED ─────────────────────────────────── {% endcomment %}
{% assign cell = grid_width | minus: gap | divided_by: 2 %}

{% comment %} ── OUTPUT ───────────────────────────────────── {% endcomment %}
<table role="presentation" cellpadding="0" cellspacing="0" border="0"
       align="center"
       width="{{ grid_width }}"
       style="width:{{ grid_width }}px; max-width:100%; opacity:{{ grid_opacity }}; background-color:{{ gap_color }}; border-radius:{{ outer_radius }}px; overflow:hidden; border-collapse:separate; border-spacing:0; mso-table-lspace:0; mso-table-rspace:0;">

  <!-- ROW 1 -->
  <tr>
    <td width="{{ cell }}" style="width:{{ cell }}px; padding:0 {{ gap }}px {{ gap }}px 0; line-height:0; font-size:0;">
      <a href="{{ link1 }}" target="_blank" style="display:block; line-height:0; font-size:0;">
        <img src="{{ img1 }}" alt="{{ alt1 }}" width="{{ cell }}" height="{{ cell }}"
             style="display:block; width:{{ cell }}px; height:{{ cell }}px; max-width:100%; object-fit:cover; border-radius:{{ cell_radius }}px; opacity:{{ img_opacity }}; border:0;" />
      </a>
    </td>
    <td width="{{ cell }}" style="width:{{ cell }}px; padding:0 0 {{ gap }}px 0; line-height:0; font-size:0;">
      <a href="{{ link2 }}" target="_blank" style="display:block; line-height:0; font-size:0;">
        <img src="{{ img2 }}" alt="{{ alt2 }}" width="{{ cell }}" height="{{ cell }}"
             style="display:block; width:{{ cell }}px; height:{{ cell }}px; max-width:100%; object-fit:cover; border-radius:{{ cell_radius }}px; opacity:{{ img_opacity }}; border:0;" />
      </a>
    </td>
  </tr>

  <!-- ROW 2 -->
  <tr>
    <td width="{{ cell }}" style="width:{{ cell }}px; padding:0 {{ gap }}px 0 0; line-height:0; font-size:0;">
      <a href="{{ link3 }}" target="_blank" style="display:block; line-height:0; font-size:0;">
        <img src="{{ img3 }}" alt="{{ alt3 }}" width="{{ cell }}" height="{{ cell }}"
             style="display:block; width:{{ cell }}px; height:{{ cell }}px; max-width:100%; object-fit:cover; border-radius:{{ cell_radius }}px; opacity:{{ img_opacity }}; border:0;" />
      </a>
    </td>
    <td width="{{ cell }}" style="width:{{ cell }}px; padding:0; line-height:0; font-size:0;">
      <a href="{{ link4 }}" target="_blank" style="display:block; line-height:0; font-size:0;">
        <img src="{{ img4 }}" alt="{{ alt4 }}" width="{{ cell }}" height="{{ cell }}"
             style="display:block; width:{{ cell }}px; height:{{ cell }}px; max-width:100%; object-fit:cover; border-radius:{{ cell_radius }}px; opacity:{{ img_opacity }}; border:0;" />
      </a>
    </td>
  </tr>

</table>
